//Generate Parentheses

// https://leetcode.com/problems/generate-parentheses/solutions/7266951/cpp-solution-for-lc-22-generate-parenthe-95xq

/*
    Intuition
Since the value of n is less, we can generate all possible combination to get our string.
 At any point of time ) brancket should not come befor the ( bracket, & there number will be same in resultant string.
*/

class Solution {
public:
    //vector<string> ans;
    void util(vector<string> &result,string &str, int open, int close){
        if(close<open)return;
        if(open<0 || close<0)return;
        if(open==0 && close==0){
            result.push_back(str);
            return;
        }
      
        if(open>0){
            str.push_back('(');
            util(result,str,open-1,close);
            str.pop_back();
        }
        if(close>open){
            str.push_back(')');
            util(result,str,open,close-1);
            str.pop_back();
        }
        return;



    }

    vector<string> generateParenthesis(int n) {
        int open=n;
        int close=n;
        vector<string> result;
        string s="";
        util(result,s,open,close);
        return result;
    }
};